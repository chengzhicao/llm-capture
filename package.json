{
  "name": "dsh-llm-capture",
  "version": "0.1.0",
  "description": "Inspect raw LLM requests and responses in DeepSeek Harness Web",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengzhicao/llm-inspector.git"
  },
  "homepage": "https://github.com/chengzhicao/llm-inspector#readme",
  "bugs": {
    "url": "https://github.com/chengzhicao/llm-inspector/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "llm",
    "inspector",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.js"
    },
    "./remote": {
      "default": "./lib/remote.js"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-fs": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.4",
    "@deepseek-ai/dsh-api-remotes": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-fs": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
